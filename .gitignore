# Debian Live Build output and working state
.venv/
__pycache__/
*.egg-info/
*.py[cod]
.pytest_cache/
build/
chroot/
binary/
cache/
.build/
*.iso
*.img
# User-specific SSH credentials. Never add private identities to the project.
/.ssh/
/.codex-*
/.devos-ssh
/.devos-ssh.pub
/.devos-known-hosts
/.devos-mirrors.env
/id_rsa*
/id_ed25519*
/id_ecdsa*
/id_dsa*
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/id_dsa*
**/*.pem
**/*.ppk
**/*.p12
**/*.pfx
**/*.key

# Generated by live-build from auto/config; regenerate for each build.
config/binary
config/bootstrap
config/chroot
config/common
config/source
config/package-lists/live.list.chroot
config/hooks/*
!config/hooks/normal/
config/hooks/normal/*
!config/hooks/normal/1200-devos-default-shell.hook.chroot
!config/hooks/normal/1300-devos-ssh-key.hook.chroot
!config/hooks/normal/1400-devos-tty2-autologin.hook.chroot

# Generated live-build manifests and package reports.
binary.modified_timestamps
chroot.files
chroot.packages.install
chroot.packages.live
live-image-amd64.contents
live-image-amd64.files
live-image-amd64.packages

# Local machine/editor files
.DS_Store
Thumbs.db
.vscode/
*.swp
