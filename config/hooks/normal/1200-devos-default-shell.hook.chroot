#!/bin/sh

set -eu

adduser_config=/etc/adduser.conf

if grep -Eq '^[[:space:]#]*DSHELL=' "$adduser_config"; then
	sed -i -E 's|^[[:space:]#]*DSHELL=.*$|DSHELL=/usr/bin/zsh|' "$adduser_config"
else
	printf '\nDSHELL=/usr/bin/zsh\n' >> "$adduser_config"
fi

install -d -m 0700 /etc/skel/.ssh
chmod 0600 /etc/skel/.ssh/authorized_keys
